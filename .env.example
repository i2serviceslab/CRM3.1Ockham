# ==========================================
# OUTCROP SILVER CORP CRM v2.1 - PRODUCTION ENV VARIABLES
# ==========================================

# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase / Vercel Postgres)
# Replace with your production PostgreSQL connection string
DATABASE_URL="postgresql://postgres:PASSWORD@ep-sample-pooler.us-east-1.aws.neon.tech/outcrop_crm?sslmode=require"
DIRECT_URL="postgresql://postgres:PASSWORD@ep-sample.us-east-1.aws.neon.tech/outcrop_crm?sslmode=require"

# 2. ENVIRONMENT & AUTHENTICATION SECRETS
NODE_ENV="production"
JWT_SECRET="generate-a-strong-secret-key-here-32-chars-minimum"
NEXTAUTH_SECRET="generate-a-strong-secret-key-here-32-chars-minimum"

# 3. EMAIL & OTP DELIVERY (Resend.com API Key for @outcropsilver.com)
RESEND_API_KEY="re_123456789_sample_key"
FROM_EMAIL="CRM Outcrop Silver <auth@outcropsilver.com>"

# 4. AI ENRICHMENT & INTELLIGENCE (OpenAI GPT-4o API Key)
OPENAI_API_KEY="sk-proj-sample-openai-api-key"

# 5. CRM DEFAULTS & TENANT LOCK
DEFAULT_TENANT_SLUG="outcrop-silver"
DEFAULT_TENANT_NAME="Outcrop Silver Corp"
